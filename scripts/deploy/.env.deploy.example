# Copie para scripts/deploy/.env.deploy (ignorado pelo Git) e ajuste se precisar.
# Os segredos (DB_URL, DB_USER, DB_PASSWORD, JWT_SECRET, OPENAI_API_KEY, RABBITMQ_URL...) vêm do .env
# da raiz do projeto: não repita aqui. O banco é o Oracle da FIAP: nenhum banco é criado na Azure.

# Região: chilecentral é a mais próxima de São Paulo entre as permitidas pela assinatura Azure for Students.
# Se a política da assinatura recusar o App Service B1 lá, troque por southafricanorth.
LOCATION=chilecentral
RESOURCE_GROUP=561413-veai-java-rg
APP_SERVICE_PLAN=561413-veai-java-plan
WEB_APP_NAME=561413-veai-java-api

# Conta do seed usada pelo smoke test (cidadã de demonstração)
SMOKE_EMAIL=ana.souza@veai.dev
SMOKE_SENHA=Veai@2026
