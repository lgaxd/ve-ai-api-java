# =============================================================================
# Vê AI · API Java · variáveis de ambiente
# Copie para .env (que NÃO vai para o git): cp .env.example .env
# A API lê o .env sozinha ao rodar da raiz do projeto (./mvnw spring-boot:run).
# No App Service / Azure DevOps, configure as mesmas chaves como variáveis de ambiente.
# No "docker compose up" (tudo em containers), a API ignora o banco e o RabbitMQ daqui e usa
# os containers do compose; do .env ela usa a IA, o JWT_SECRET e os opcionais.
# =============================================================================

# Perfil: local (Oracle XE do docker-compose) | fiap (Oracle da FIAP) | azure (Azure SQL)
SPRING_PROFILES_ACTIVE=local

# --- Banco Oracle da FIAP (perfil fiap) --------------------------------------
# Usuário = RM com prefixo "rm" (ex.: rm561413). Senha = a do Oracle da FIAP
# (normalmente a data de nascimento no formato DDMMAA, se você nunca trocou).
# Fora da rede da FIAP, o acesso pode exigir a VPN da faculdade.
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USER=rm000000
DB_PASSWORD=

# Fuso das colunas DATE. O PL/SQL do repositório database usa SYSDATE (fuso do servidor).
# Se o "SELECT TO_CHAR(SYSDATE, 'HH24:MI') FROM dual" na FIAP mostrar o horário de Brasília,
# use America/Sao_Paulo para as datas gravadas pela API e pelo PL/SQL ficarem no mesmo fuso.
DB_TIME_ZONE=UTC

# Conexões simultâneas com o banco (o Oracle da FIAP limita sessões por aluno)
DB_POOL_MAX=5

# --- Oracle local (perfil local) ---------------------------------------------
# Já têm valor padrão igual ao docker-compose.yml; só mude se usar outro Oracle local.
# LOCAL_DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
# LOCAL_DB_USER=veai
# LOCAL_DB_PASSWORD=veai

# --- RabbitMQ ------------------------------------------------------------------
# Local: o do docker-compose. CloudAMQP: amqps://usuario:senha@host/vhost
RABBITMQ_URL=amqp://veai:veai@localhost:5672

# --- Segurança -----------------------------------------------------------------
# JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=

# --- IA ----------------------------------------------------------------------
# falso = respostas fixas, sem custo | openai = GPT real (gasta créditos)
VEAI_IA_PROVEDOR=falso
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Deixe vazio para gpt-5+/gpt-6 (só aceitam o padrão). Ex.: 0.2 para gpt-4o/gpt-4.1
OPENAI_TEMPERATURE=

# --- Opcionais -----------------------------------------------------------------
# Serviço RAG NBR 9050 (FastAPI). Vazio = desligado.
VEAI_RAG_URL=
VEAI_RATE_LIMIT=20
VEAI_CORS_ORIGENS=*
PORT=8080

# --- Portas do docker compose (opcional, só se as padrão estiverem ocupadas) ---------
# API_PORT=8080
# ORACLE_PORT=1521
# RABBITMQ_PORT=5672
# RABBITMQ_PAINEL_PORT=15672
