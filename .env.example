# Vê AI · API Java · variáveis de ambiente
# Copie para .env (que NÃO vai para o git) ou configure no App Service / Azure DevOps.
# No perfil "local" todas têm valor padrão; nos perfis "java" e "azure" as de banco são obrigatórias.

# Perfil: local | java | azure
SPRING_PROFILES_ACTIVE=local

# Banco
DB_URL=jdbc:postgresql://localhost:5432/veai
# Azure SQL: jdbc:sqlserver://<servidor>.database.windows.net:1433;databaseName=veai;encrypt=true
DB_USER=veai
DB_PASSWORD=

# RabbitMQ (CloudAMQP: amqps://usuario:senha@host/vhost)
RABBITMQ_URL=amqp://veai:veai@localhost:5672

# JWT: no mínimo 32 caracteres aleatórios
JWT_SECRET=

# IA: falso (sem custo) | openai
VEAI_IA_PROVEDOR=falso
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Opcionais
VEAI_RAG_URL=
VEAI_RATE_LIMIT=20
VEAI_CORS_ORIGENS=*
PORT=8080
